# GMO Coin ingestor defaults
INGESTOR__WS_ENDPOINT=wss://api.coin.z.com/ws/public/v1
INGESTOR__SYMBOLS=BTC_JPY,ETH_JPY
INGESTOR__CHANNELS=ticker,trades,orderbooks
INGESTOR__ADMIN__BIND_ADDR=0.0.0.0:9090
INGESTOR__KAFKA__BROKERS=localhost:19092
INGESTOR__KAFKA__CLIENT_ID=gmocoin-ingestor-local
INGESTOR__TOPICS__TRADES=gmo.market.trades
INGESTOR__TOPICS__TICKER=gmo.market.ticker
INGESTOR__TOPICS__ORDERBOOK=gmo.market.orderbook.snapshot

# Backtesting API defaults
BACKTEST__GRPC_BIND_ADDR=0.0.0.0:8080
BACKTEST__ADMIN__BIND_ADDR=0.0.0.0:8081
BACKTEST__CLICKHOUSE__URL=http://localhost:8123
BACKTEST__CLICKHOUSE__DATABASE=gmo
# Uncomment to enable bearer auth
# BACKTEST__BEARER_AUTH__TOKEN=supersecret
